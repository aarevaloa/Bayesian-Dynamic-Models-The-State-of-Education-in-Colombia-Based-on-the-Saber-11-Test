# -*- coding: utf-8 -*-
# _____________________________________________________________________________
# @  MODELO 4 - (20) COVARIABLES: EFECTOS Y CONTEXTO
# _____________________________________________________________________________
# SUSTITUYE Y ABSORBE AL MODULO 15, que queda eliminado del pipeline.
#
# El 15 mantenia su propia copia de resumen(), senda(), forest(), sendas(),
# cargar_geojson() y eje_mapa(). Cuando estilo_M4 paso a promediar solo los
# periodos pares, esa copia se quedo promediando los 16 y los dos modulos
# empezaron a reportar numeros distintos para el mismo coeficiente (calen_B:
# +19.9 en figR5, +6.2 en fig07-13). Fusionarlos elimina la duplicacion de raiz:
# hay un unico lugar donde se define el promedio y un unico lugar donde se
# dibuja un forest.
#
# Lo que NO se conserva del 15: los mapas de dispersion departamental
# (mapa_dispersion_*.png y el gif). Ese resultado ya sale numericamente en la
# tabla que imprime el modulo 17, y su version cartografica cabe en el 19, que
# es el modulo territorial y ya tiene la geografia cargada.
#
# ------------------------------- FIGURAS -------------------------------------
# BLOQUE A - efectos de las covariables individuales (venia del 15)
#   figR1_trabajo.png        horas de trabajo semanal
#   figR2_padres.png         escalera de educacion de la madre
#   figR3_violencia.png      violencia municipal, en desviaciones estandar
#   figR4_panorama.png       los 16 mayores efectos, por bloque jerarquico
#   figR5_hogar_colegio.png  recursos del hogar y atributos del colegio
#   figR6_calendario.png     calendario escolar: solo senda, no promedio
# BLOQUE B - alimentacion, dedicacion y contexto territorial
#   fig07_alimentacion.png   frecuencia de carne, cereal y leche
#   fig08_lectura_internet.png horas de lectura frente a horas de internet
#   fig09_contexto_muni.png  bloque M en UNIDADES REALES
#   fig10_contexto_depto.png bloque D en UNIDADES REALES
#   fig11_cambio_temporal.png Delta theta entre periodos del mismo semestre
#   fig12_ranking.png        distribucion posterior del rango + contribucion
#   fig13_faltantes.png      indicadores de faltante, diagnostico
#
# ------------------------------ DOS REGLAS -----------------------------------
# (1) PROMEDIO SOBRE PERIODOS PARES. Los impares son el primer semestre
#     (calendario B y rezagados): el 10.5% de las observaciones. Promediar los
#     16 con peso igual les da el 50% del promedio, cambia el signo de tres
#     coeficientes y el estatus de credibilidad de seis. P.resumen() y P.draws()
#     usan solo los pares por defecto; las SENDAS si dibujan los 16, con los
#     impares sombreados, porque ahi el punto es ver la trayectoria.
# (2) CAMBIO ENTRE PERIODOS DEL MISMO SEMESTRE. Medido de t=1 a t=16, trabajar
#     mas de 30 h parece empeorar 10.4 puntos; medido par contra par, 3.1. La
#     diferencia es artefacto semestral.
#
# UNIDADES REALES: beta_original = beta_estandarizado / sd_x, con sd_x tomada de
# estandar_params.csv, multiplicado por una unidad legible.
# _____________________________________________________________________________

import os, sys, time, warnings
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import estilo_M4 as E

warnings.filterwarnings("ignore", message="All-NaN slice encountered")

t0 = time.time()
def paso(m):
    print(f"[{time.time()-t0:6.1f}s] {m}", flush=True)

paso("cargando cache y posterior")
D = E.cargar_cache()
P = E.cargar_posterior()
et = list(D["et_periodo"])
pares = np.where(D["es_par"])[0]
Tt = P.Tt
est_var, est_sd = D["est_var"], D["est_sd"]
CONTINUAS = set(map(str, est_var))          # las estandarizadas en la Etapa 1

def exigir(noms, donde):
    """Comprueba de una vez que los nombres existen. Sin esto, un rotulo mal
    escrito o una categoria de referencia distinta mata el script a mitad de
    camino, con media docena de figuras ya escritas en disco."""
    falta = [n for n in noms if n not in P.ix]
    if falta:
        raise KeyError(f"{donde}: no estan en theta_labels -> {falta}")

def sd_de(nom):
    """sd original de una covariable continua. Falla si no esta: devolver 1.0 en
    silencio convertiria un error de tipeo, o una variable eliminada por el
    filtro QR de la Etapa 1, en un efecto mal escalado sin ningun aviso."""
    i = np.where(est_var == nom)[0]
    if not len(i):
        raise KeyError(f"'{nom}' no esta en estandar_params.csv. Variables "
                       f"disponibles: {sorted(map(str, est_var))}")
    return float(est_sd[i[0]])

# ---- utilidades comunes -----------------------------------------------------
XLAB = ("efecto sobre el puntaje global (puntos)\n"
        "promedio de los ocho periodos pares, IC 95%")

def par_paneles(alto=4.6, ancho=13.4, razon=(1, 1.05)):
    fig, axs = plt.subplots(1, 2, figsize=(ancho, alto), width_ratios=razon)
    return fig, axs

def cerrar(fig, titulo, nombre, rect=(0, 0, 1, 0.90)):
    if titulo:
        fig.suptitle(titulo)
    fig.tight_layout(rect=rect)
    E.guardar(fig, nombre, cerrar=True)

def eje_periodos(ax, cada=1):
    """Sombrea los impares y rotula con los periodos reales."""
    E.marcar_semestres(ax, Tt)
    ax.set_xticks(range(1, Tt + 1, cada))
    ax.set_xticklabels(et[::cada], rotation=90 if cada == 1 else 45,
                       fontsize=6.5 if cada == 1 else 7)
    ax.set_xlabel("periodo (sombreado: primer semestre, otra población)")

def escalera(ax_f, ax_s, noms, ets, cols, tit_f, tit_s, anot="pos"):
    """Forest del efecto promedio + sendas. El patron de todo el modulo."""
    rs = E.forest(ax_f, noms, ets, cols, tit_f, anot_p=anot)
    ax_f.set_xlabel(XLAB)
    E.sendas(ax_s, noms, ets, cols, tit_s)
    eje_periodos(ax_s, cada=2)
    return rs

# Comprobacion previa: todos los nombres que pide el modulo, de una sola vez.
_TODOS = {
 "trabajo": ["trabaja_MENOS.DE.10.HORAS","trabaja_ENTRE.11.Y.20.HORAS",
             "trabaja_ENTRE.21.Y.30.HORAS","trabaja_MÁS.DE.30.HORAS"],
 "educacion de la madre": [f"edu_madre_{s}" for s in
   ["PRIMARIA.INCOMPLETA","PRIMARIA.COMPLETA",
    "SECUNDARIA..BACHILLERATO..INCOMPLETA","SECUNDARIA..BACHILLERATO..COMPLETA",
    "TÉCNICA.O.TECNOLÓGICA.INCOMPLETA","TÉCNICA.O.TECNOLÓGICA.COMPLETA",
    "EDUCACIÓN.PROFESIONAL.INCOMPLETA","EDUCACIÓN.PROFESIONAL.COMPLETA",
    "POSTGRADO"]],
 "violencia": ["TASA_HOMICIDIOS","PROP_HOMICIDIOS_URBANO","TASA_VICTIMAS"],
 "hogar": ["estu_inse_individual","libros_casa_11.A.25.LIBROS",
           "libros_casa_26.A.100.LIBROS","libros_casa_MÁS.DE.100.LIBROS",
           "compu_casa_SI","internet_SI"],
 "colegio": ["cole_natu_NO_OFICIAL","cole_bilingue_S",
             "cole_area_ubicacion_RURAL","genero_F","calen_B","calen_OTRO"],
 "alimentacion": [f"{b}_{n}" for b in ("come_carne","come_cereal","come_leche")
   for n in ("1.O.2.VECES.POR.SEMANA","3.A.5.VECES.POR.SEMANA",
             "TODOS.O.CASI.TODOS.LOS.DÍAS")],
 "lectura": [f"lectu_{s}" for s in ("30.MINUTOS.O.MENOS",
   "ENTRE.30.Y.60.MINUTOS","ENTRE.1.Y.2.HORAS","MÁS.DE.2.HORAS")],
 "internet": [f"inter_{s}" for s in ("30.MINUTOS.O.MENOS",
   "ENTRE.30.Y.60.MINUTOS","ENTRE.1.Y.3.HORAS","MÁS.DE.3.HORAS")],
}
for _g, _ns in _TODOS.items():
    exigir(_ns, _g)
paso(f"   {sum(len(v) for v in _TODOS.values())} nombres verificados contra "
     f"theta_labels")


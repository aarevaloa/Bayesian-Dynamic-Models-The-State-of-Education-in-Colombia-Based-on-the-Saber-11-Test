# ==================== FIG 09/10: CONTEXTO EN UNIDADES REALES =================
# (variable, multiplicador sobre la unidad original, etiqueta de la unidad)
MUNI = [("TASA_HOMICIDIOS", 10, "+10 homicidios por 100 mil hab."),
        ("TASA_VICTIMAS", 10000, "+10 pp de la población como víctimas"),
        ("PROP_HOMICIDIOS_URBANO", 0.10, "+10 pp de homicidios urbanos"),
        ("PROP_NBI", 10, "+10 pp de necesidades básicas insatisfechas"),
        ("COMP_INASISTENCIA_ESCOLAR", 1, "+1 punto de inasistencia escolar"),
        ("PROP_URBANA", 0.10, "+10 pp de población urbana"),
        ("SGP_EDUC_PC", 100000, "+100 mil pesos de SGP educativo per cápita"),
        ("TASA_MATRICULA_ES", 10, "+10 puntos de matrícula en educación superior"),
        ("IES_CON_OFERTA", 10, "+10 instituciones con oferta"),
        ("LOG_POBLACION", np.log(2), "duplicar la población")]
DEPTO = [("IPM", 10, "+10 puntos del índice de pobreza multidimensional"),
         ("TASA_DESEMPLEO", 1, "+1 pp de desempleo"),
         ("TASA_SUBOCUPACION", 1, "+1 pp de subocupación"),
         ("CREC_PIB_REAL", 1, "+1 pp de crecimiento del PIB"),
         # PIB_CONSTANTE viene en MILES DE MILLONES (media 76 382 = 76.4 billones,
         # que es como el DANE publica el PIB departamental): 10 000 unidades son
         # diez billones de pesos, no diez mil millones.
         ("PIB_CONSTANTE", 10000, "+10 billones de PIB departamental")]

def contexto(tabla, color, titulo, nombre):
    rs_c, ets_c, cols_c = [], [], []
    for nom, mult, et_u in tabla:
        f = mult / sd_de(nom)                       # de sd a unidad legible
        d = P.draws(nom) * f                        # promedio sobre pares
        rs_c.append(dict(mediana=float(np.median(d)),
                         lo=float(np.quantile(d, .025)),
                         hi=float(np.quantile(d, .975)),
                         p_neg=float(np.mean(d < 0)), p_pos=float(np.mean(d > 0))))
        ets_c.append(et_u); cols_c.append(color)
    fig, axs = par_paneles(alto=max(4.8, 0.52 * len(tabla) + 2.4))
    E.forest_dict(axs[0], rs_c, ets_c, cols_c,
                  "Efecto por unidad interpretable (IC 95%)", anot_p="neg",
                  xlab="cambio en el puntaje global (puntos)\n"
                       "promedio de los ocho periodos pares, IC 95%")
    noms = [t[0] for t in tabla]
    ramp = plt.get_cmap("cividis")(np.linspace(.15, .85, len(noms)))
    E.sendas(axs[1], noms, [t[0].replace("_", " ").title() for t in tabla], ramp,
             "Sendas en desviaciones estándar (banda 90%)")
    eje_periodos(axs[1], cada=2)
    axs[1].legend(frameon=False, fontsize=6.5, ncol=2)
    cerrar(fig, titulo, nombre)
    return rs_c

paso("fig09 contexto municipal")
rs_m = contexto(MUNI, E.C["M"],
                "¿Cuánto pesa el contexto municipal?  Efectos en unidades reales",
                "fig09_contexto_muni.png")
paso("fig10 contexto departamental")
rs_d = contexto(DEPTO, E.C["D"],
                "¿Cuánto pesa el contexto departamental?  Efectos en unidades reales",
                "fig10_contexto_depto.png")

# ======================= FIG 11: CAMBIO TEMPORAL =============================
paso("fig11 cambio temporal")
mag = np.array([abs(P.resumen(l)["mediana"]) for l in cands])
sel = [cands[i] for i in np.argsort(-mag)[:18]]
cam = [P.cambio(l) for l in sel]                      # 2017-2 contra 2024-2
orden = np.argsort([c["mediana"] for c in cam])
sel = [sel[i] for i in orden]; cam = [cam[i] for i in orden]
cols = [E.C[E.bloque(l)] for l in sel]
ets_c = [l.replace("_", " ").replace(".", " ").lower() for l in sel]

fig, ax = plt.subplots(figsize=(11.8, 7.4))
E.forest_dict(ax, cam, ets_c, cols,
              f"Cambio del efecto entre {et[cam[0]['t0']-1]} y {et[cam[0]['t1']-1]}",
              anot_p="pos", xlab="cambio del coeficiente (puntos), IC 95%")
for b, nom_b in (("E", "Estudiante"), ("M", "Municipal"), ("D", "Departamental")):
    ax.plot([], [], "s", color=E.C[b], ms=8, label=nom_b)
ax.legend(frameon=False, fontsize=8, loc="lower right")
cerrar(fig, "¿Qué efectos se ampliaron y cuáles se cerraron?\n"
            "comparación entre periodos del mismo semestre, no entre t = 1 y t = 16",
       "fig11_cambio_temporal.png")

# ==================== FIG 12: RANKING POSTERIOR Y CONTRIBUCION ===============
paso("fig12 ranking posterior y contribucion")
# Ordenar por |promedio| hunde a los coeficientes cuyo efecto es grande en algun
# periodo pero se cancela al promediar: CREC_PIB_REAL tiene 0.90 de promedio y
# 10.34 de maximo, y come_leche_MISSING 5.25 contra 19.04. El criterio de
# "importancia" es por tanto el maximo temporal.
mag_max = np.array([np.abs(np.median(P.draws_t(l), axis=1)).max() for l in cands])
top = [cands[i] for i in np.argsort(-mag_max)[:14]]
B = np.abs(np.vstack([P.draws(l) for l in top]))       # (n_top, S)
rangos = (-B).argsort(axis=0).argsort(axis=0) + 1      # 1 = efecto mayor
H = np.vstack([[np.mean(rangos[i] == r) for r in range(1, len(top) + 1)]
               for i in range(len(top))])
ord_r = np.argsort([np.mean(rangos[i]) for i in range(len(top))])

# Contribucion empirica: sd de la covariable x magnitud del efecto. La rama se
# elige con estandar_params.csv, no con una heuristica sobre el signo: lo que
# figura ahi son las continuas estandarizadas (sd = 1 por construccion) y el
# resto son indicadoras 0/1, cuya sd es sqrt(p(1-p)) con p la prevalencia.
wD = np.where(np.isfinite(D["Xbar_D"][0]), D["n_D"], 0).astype(float)
wD = wD / wD.sum()
contrib = []
for l in top:
    if str(l) in CONTINUAS:
        sdx = 1.0
    else:
        x = D["Xbar_D"][P.ix[l]]
        pr = float(np.nansum(np.where(np.isfinite(x), x * wD, 0)))
        pr = min(max(pr, 0.0), 1.0)
        sdx = np.sqrt(pr * (1 - pr))
    contrib.append(sdx * abs(P.resumen(l)["mediana"]))
contrib = np.array(contrib)

fig, axs = plt.subplots(1, 2, figsize=(14.4, 6.6), width_ratios=(1.25, 1))
im = axs[0].imshow(H[ord_r], cmap="magma_r", aspect="auto", vmin=0, vmax=1)
axs[0].set_yticks(range(len(top)))
axs[0].set_yticklabels([top[i].replace("_", " ").replace(".", " ").lower()
                        for i in ord_r], fontsize=7.5)
axs[0].set_xticks(range(len(top)))
axs[0].set_xticklabels(range(1, len(top) + 1), fontsize=8)
axs[0].set_xlabel("posición en el ranking por magnitud")
axs[0].grid(False)
fig.colorbar(im, ax=axs[0], fraction=0.03, pad=0.02, label="probabilidad posterior")
axs[0].set_title("¿Es robusto el orden de importancia?\nprobabilidad de ocupar "
                 "cada posición (selección por máximo temporal)")

o2 = np.argsort(contrib)
axs[1].barh(range(len(top)), contrib[o2],
            color=[E.C[E.bloque(top[i])] for i in o2], height=0.68)
axs[1].set_yticks(range(len(top)))
axs[1].set_yticklabels([top[i].replace("_", " ").replace(".", " ").lower()
                        for i in o2], fontsize=7.5)
axs[1].set_xlabel("sd de la covariable × |efecto| (puntos)")
axs[1].set_title("Contribución empírica\nun efecto grande sobre algo raro explica poco")
cerrar(fig, "Priorización de factores: magnitud, incertidumbre y prevalencia",
       "fig12_ranking.png")

# ========================= FIG 13: INDICADORES DE FALTANTE ===================
paso("fig13 faltantes")
falt = [l for l in P.labels if l.endswith("MISSING")]
rs_f = [P.resumen(l) for l in falt]
o3 = np.argsort([r["mediana"] for r in rs_f])
falt = [falt[i] for i in o3]; rs_f = [rs_f[i] for i in o3]
fig, ax = plt.subplots(figsize=(11.8, 0.42 * len(falt) + 2.8))
E.forest_dict(ax, rs_f, [l.replace("_MISSING", "").replace("_", " ").lower()
                         for l in falt],
              [E.C[E.bloque(l)] for l in falt],
              "Efecto asociado a tener el dato ausente (IC 95%)", anot_p="pos",
              xlab=XLAB)
cerrar(fig, "Diagnóstico: los indicadores de faltante no son neutrales\n"
            "varios alcanzan magnitudes comparables a las covariables sustantivas",
       "fig13_faltantes.png")

# ============================== INFORME ======================================
def linea(r, etq, nom=None):
    extra = ""
    if nom is not None:
        extra = f"   [16 per.: {P.resumen(nom, pares=False)['mediana']:+7.2f}]"
    print(f"    {etq:<30} {r['mediana']:+7.2f}  "
          f"IC95 [{r['lo']:+7.2f}, {r['hi']:+7.2f}]   "
          f"P(<0)={r['p_neg']:.3f}  P(>0)={r['p_pos']:.3f}{extra}")

print("\n" + "=" * 96)
print("EFECTOS DE LAS COVARIABLES  (puntos del puntaje global, promedio de los "
      "OCHO PERIODOS PARES)")
print("Entre corchetes, el promedio de los 16 periodos, que mezcla semestres y "
      "NO debe citarse.")
print("=" * 96)

for tit, noms_g, ets_g, rs_g in (
        ("Trabajo (vs. no trabaja)", TR, TR_ET, RS_TR),
        ("Educación de la madre (vs. referencia)", ESC, ESC_ET, RS_ESC),
        ("Violencia municipal (por +1 sd)", VIO, VIO_ET, RS_VIO),
        ("Hogar", HOG, HOG_ET, RS_HOG),
        ("Colegio y estudiante", COL, COL_ET, RS_COL)):
    print(f"\n  {tit}")
    for n, e, r in zip(noms_g, ets_g, rs_g):
        linea(r, e, n)

print("\n  Calendario: NO promediable, se reporta el rango de la senda")
for n, e in (("calen_B", "Calendario B"), ("calen_OTRO", "Calendario otro")):
    s = np.median(P.draws_t(n), axis=1)
    print(f"    {e:<30} impares [{s[0::2].min():+6.1f}, {s[0::2].max():+6.1f}]"
          f"    pares [{s[1::2].min():+6.1f}, {s[1::2].max():+6.1f}]")

print("\n  Alimentación (frente a nunca o rara vez)")
for base, (nom_leg, _) in COMIDA.items():
    n = f"{base}_TODOS.O.CASI.TODOS.LOS.DÍAS"
    linea(P.resumen(n), nom_leg.split(",")[0] + " diario", n)

print("\n  Lectura frente a internet (nivel máximo de dedicación)")
for n, tt in (("lectu_MÁS.DE.2.HORAS", "leer más de 2 h"),
              ("inter_MÁS.DE.3.HORAS", "navegar más de 3 h")):
    linea(P.resumen(n), tt, n)

print("\n  Contexto MUNICIPAL en unidades reales")
for (nom, _, et_u), r in zip(MUNI, rs_m):
    print(f"    {et_u:<52} {r['mediana']:+6.2f}  "
          f"[{r['lo']:+6.2f}, {r['hi']:+6.2f}]  P(<0) = {r['p_neg']:.3f}")
print("\n  Contexto DEPARTAMENTAL en unidades reales")
for (nom, _, et_u), r in zip(DEPTO, rs_d):
    print(f"    {et_u:<52} {r['mediana']:+6.2f}  "
          f"[{r['lo']:+6.2f}, {r['hi']:+6.2f}]  P(<0) = {r['p_neg']:.3f}")

print(f"\n  Cambio temporal entre {et[cam[0]['t0']-1]} y {et[cam[0]['t1']-1]}")
for c, l in zip(cam, sel):
    if c["p_pos"] > 0.95 or c["p_neg"] > 0.95:
        print(f"    {l:<46} {c['mediana']:+6.2f}  "
              f"[{c['lo']:+6.2f}, {c['hi']:+6.2f}]  "
              f"P = {max(c['p_pos'], c['p_neg']):.3f}")
print("    (solo se listan los cambios con probabilidad posterior mayor que 0.95)")

print("\n  Faltantes con efecto mayor que 10 puntos en magnitud")
for l, r in zip(falt, rs_f):
    if abs(r["mediana"]) > 10:
        print(f"    {l:<46} {r['mediana']:+6.2f}  "
              f"[{r['lo']:+6.2f}, {r['hi']:+6.2f}]")
paso("LISTO")

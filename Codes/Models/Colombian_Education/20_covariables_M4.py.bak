fig, axs = plt.subplots(1, 2, figsize=(12.8, 5.4), width_ratios=(1.35, 1))
E.sendas(axs[0], TR, TR_ET, E.C_TRABAJO, "Sendas dinámicas del efecto (banda 90%)")

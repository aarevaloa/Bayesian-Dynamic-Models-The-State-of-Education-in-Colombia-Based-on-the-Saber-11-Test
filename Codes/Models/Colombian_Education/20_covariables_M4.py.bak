paso("figR1 trabajo")
TR = ["trabaja_MENOS.DE.10.HORAS", "trabaja_ENTRE.11.Y.20.HORAS",
      "trabaja_ENTRE.21.Y.30.HORAS", "trabaja_MÁS.DE.30.HORAS"]
